{
  "info": {
    "name": "Tiozihuatl Mobile",
    "description": "Pruebas de integración de la app móvil contra la API. Cada carpeta es una historia de usuario y se ejecuta con su archivo de datos de tests/postman/datos/<carpeta>.json.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "hu01-registro",
      "description": "HU-01 Registro de visitante. Solo usa casos que no crean cuentas ni envían correos.",
      "item": [
        {
          "name": "Consultar si el correo ya está registrado",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const caso = pm.iterationData.get('caso');",
                  "pm.test(`[${caso}] responde 200`, () => pm.response.to.have.status(200));",
                  "pm.test(`[${caso}] indica si el correo existe`, () => {",
                  "  pm.expect(pm.response.json().exists).to.eql(pm.iterationData.get('correoRegistrado'));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/check-email?correo={{correo}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "check-email"
              ],
              "query": [
                {
                  "key": "correo",
                  "value": "{{correo}}"
                }
              ]
            }
          }
        },
        {
          "name": "Consultar si el teléfono ya está registrado",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const caso = pm.iterationData.get('caso');",
                  "pm.test(`[${caso}] responde 200`, () => pm.response.to.have.status(200));",
                  "pm.test(`[${caso}] indica si el teléfono existe`, () => {",
                  "  pm.expect(pm.response.json().exists).to.eql(pm.iterationData.get('telefonoRegistrado'));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/check-phone?telefono={{telefono}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "check-phone"
              ],
              "query": [
                {
                  "key": "telefono",
                  "value": "{{telefono}}"
                }
              ]
            }
          }
        },
        {
          "name": "Pre-registro con datos inválidos",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const caso = pm.iterationData.get('caso');",
                  "pm.test(`[${caso}] rechaza los datos con 400`, () => pm.response.to.have.status(400));",
                  "pm.test(`[${caso}] explica el error al usuario`, () => {",
                  "  pm.expect(pm.response.json().error).to.be.a('string').and.not.empty;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/pre-registro",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "pre-registro"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"{{nombreInvalido}}\",\n  \"apaterno\": \"{{apaternoInvalido}}\",\n  \"amaterno\": \"\",\n  \"correo\": \"{{correoInvalido}}\",\n  \"telefono\": \"{{telefonoInvalido}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Finalizar registro sin pre-registro",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const caso = pm.iterationData.get('caso');",
                  "pm.test(`[${caso}] no crea la cuenta sin verificar el correo (400)`, () => pm.response.to.have.status(400));",
                  "pm.test(`[${caso}] indica que falta el pre-registro`, () => {",
                  "  pm.expect(String(pm.response.json().error).toLowerCase()).to.include('pre-registro');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/finalizar-registro",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "finalizar-registro"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"correo\": \"{{correo}}\",\n  \"contrasena\": \"{{contrasena}}\",\n  \"palabra_secreta\": \"{{palabraSecreta}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    },
    {
      "name": "hu02-login",
      "description": "HU-02 Inicio de sesión. La API es la de producción: no se usan cuentas reales ni contraseñas incorrectas de usuarios existentes, porque 3 intentos fallidos bloquean la cuenta 15 minutos. El login correcto y los roles se validan en la prueba de aceptación.",
      "item": [
        {
          "name": "Login con usuario inexistente",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// En el modo Performance de Postman no llegan los datos del archivo: se usa un nombre por defecto.",
                  "const caso = pm.iterationData.get('caso') ?? 'sin archivo de datos';",
                  "pm.test(`[${caso}] rechaza las credenciales con 401`, () => pm.response.to.have.status(401));",
                  "pm.test(`[${caso}] no entrega tokens`, () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body).to.not.have.property('accessToken');",
                  "  pm.expect(body).to.not.have.property('refreshToken');",
                  "});",
                  "pm.test(`[${caso}] explica el error`, () => pm.expect(pm.response.json().error).to.eql('Usuario no encontrado.'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"credential\": \"{{credencialInexistente}}\",\n  \"contrasena\": \"{{contrasena}}\",\n  \"rolSeleccionado\": \"{{rol}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Login sin datos obligatorios",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// En el modo Performance de Postman no llegan los datos del archivo: se usa un nombre por defecto.",
                  "const caso = pm.iterationData.get('caso') ?? 'sin archivo de datos';",
                  "pm.test(`[${caso}] rechaza la petición con 400`, () => pm.response.to.have.status(400));",
                  "pm.test(`[${caso}] indica que faltan datos`, () => pm.expect(pm.response.json().error).to.eql('Faltan credenciales o rol.'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"credential\": \"\",\n  \"contrasena\": \"\",\n  \"rolSeleccionado\": \"{{rol}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Consultar sesión sin token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// En el modo Performance de Postman no llegan los datos del archivo: se usa un nombre por defecto.",
                  "const caso = pm.iterationData.get('caso') ?? 'sin archivo de datos';",
                  "pm.test(`[${caso}] niega el acceso con 401`, () => pm.response.to.have.status(401));",
                  "pm.test(`[${caso}] indica que falta el token`, () => pm.expect(pm.response.json().error).to.eql('Token no proporcionado'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "me"
              ]
            }
          }
        },
        {
          "name": "Consultar sesión con token alterado",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// En el modo Performance de Postman no llegan los datos del archivo: se usa un nombre por defecto.",
                  "const caso = pm.iterationData.get('caso') ?? 'sin archivo de datos';",
                  "pm.test(`[${caso}] niega el acceso con 401`, () => pm.response.to.have.status(401));",
                  "pm.test(`[${caso}] indica que el token no es válido`, () => pm.expect(pm.response.json().error).to.eql('Token invalido o expirado'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{tokenAlterado}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "me"
              ]
            }
          }
        },
        {
          "name": "Renovar sesión con token de renovación inválido",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// En el modo Performance de Postman no llegan los datos del archivo: se usa un nombre por defecto.",
                  "const caso = pm.iterationData.get('caso') ?? 'sin archivo de datos';",
                  "pm.test(`[${caso}] no renueva la sesión (401)`, () => pm.response.to.have.status(401));",
                  "pm.test(`[${caso}] no entrega tokens nuevos`, () => pm.expect(pm.response.json()).to.not.have.property('accessToken'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/refresh",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "refresh"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id_usuario\": 999999999,\n  \"refreshToken\": \"{{tokenAlterado}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Cerrar sesión con token alterado",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// En el modo Performance de Postman no llegan los datos del archivo: se usa un nombre por defecto.",
                  "const caso = pm.iterationData.get('caso') ?? 'sin archivo de datos';",
                  "pm.test(`[${caso}] rechaza el cierre con 403`, () => pm.response.to.have.status(403));",
                  "pm.test(`[${caso}] indica que el token no es válido`, () => pm.expect(pm.response.json().error).to.eql('Token inválido o expirado.'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{tokenAlterado}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/logout",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "logout"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id_usuario\": 999999999\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    }
  ]
}
