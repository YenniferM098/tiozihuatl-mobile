                  "pm.test(`[${caso}] trae título, autoría, editorial y materias`, () => {",
                  "  pm.expect(libro.titulo).to.be.a('string').and.not.empty;",
                  "  pm.expect(libro).to.include.keys('autores', 'editorial', 'materias', 'semestres');",
