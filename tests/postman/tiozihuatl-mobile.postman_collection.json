    {
      "name": "hu02-login",
      "description": "HU-02 Inicio de sesión. La API es la de producción: no se usan cuentas reales ni contraseñas incorrectas de usuarios existentes, porque 3 intentos fallidos bloquean la cuenta 15 minutos. El login correcto y los roles se validan en la prueba de aceptación.",
      "item": [
        {
          "name": "Login con usuario inexistente",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// En el modo Performance de Postman no llegan los datos del archivo: se usa un nombre por defecto.",
                  "const caso = pm.iterationData.get('caso') ?? 'sin archivo de datos';",
                  "pm.test(`[${caso}] rechaza las credenciales con 401`, () => pm.response.to.have.status(401));",
                  "pm.test(`[${caso}] no entrega tokens`, () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body).to.not.have.property('accessToken');",
                  "  pm.expect(body).to.not.have.property('refreshToken');",
                  "});",
                  "pm.test(`[${caso}] explica el error`, () => pm.expect(pm.response.json().error).to.eql('Usuario no encontrado.'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"credential\": \"{{credencialInexistente}}\",\n  \"contrasena\": \"{{contrasena}}\",\n  \"rolSeleccionado\": \"{{rol}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
