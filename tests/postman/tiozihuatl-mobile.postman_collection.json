        {
          "name": "Filtrar libros por semestre",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// En el modo Performance de Postman no llegan los datos del archivo: se usa un nombre por defecto.",
                  "const caso = pm.iterationData.get('caso') ?? 'sin archivo de datos';",
                  "pm.test(`[${caso}] responde 200`, () => pm.response.to.have.status(200));",
                  "const libros = pm.response.json();",
                  "pm.test(`[${caso}] devuelve al menos 1 libro`, () => {",
                  "  pm.expect(libros).to.be.an('array');",
                  "  pm.expect(libros.length).to.be.at.least(1);",
                  "});",
                  "const semestre = String(pm.variables.get('semestreId'));",
