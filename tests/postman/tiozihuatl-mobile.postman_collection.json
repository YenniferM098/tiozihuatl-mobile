                  "pm.test(`[${caso}] indica la disponibilidad de ejemplares físicos`, () => {",
                  "  pm.expect(libro.tiene_fisico, 'tiene_fisico').to.be.oneOf([0, 1]);",
                  "  if (libro.tiene_fisico === 1) {",
                  "    pm.expect(libro.total, 'total').to.be.a('number');",
                  "    pm.expect(libro.disponibles, 'disponibles').to.be.a('number');",
                  "    pm.expect(libro.disponibles).to.be.within(0, libro.total);",
                  "  }",
                  "});",
                  "pm.test(`[${caso}] indica si tiene contenido digital`, () => {",
                  "  const esperaDigital = String(pm.variables.get('esperaDigital')) === 'true';",
                  "  pm.expect(libro.tiene_digital).to.eql(esperaDigital ? 1 : 0);",
                  "});"
                ]
              }
            }
