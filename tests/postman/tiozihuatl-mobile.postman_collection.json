    {
      "name": "hu04-biblioteca",
      "description": "HU-04 Consulta de Biblioteca Digital. Endpoints públicos del catálogo (GET /catalog, /catalog/materias y /catalog/semestres): listado, búsqueda por título o autor, filtros por materia, semestre y formato, ordenamiento por autor, disponibilidad física y contenido digital. La API no tiene un endpoint de detalle por ID: igual que la app, el detalle se obtiene del catálogo. Solo consulta datos; no modifica nada.",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Valores por defecto para el modo Performance de Postman, que no recibe el archivo de datos.",
              "const porDefecto = { busquedaTitulo: 'Anatomía', busquedaAutor: 'Campohermoso', materia: 'Anatomía', semestreId: '1',",
              "  busquedaSinResultados: 'zzqx-sin-resultados-hu04', libroId: 52, esperaDigital: true };",
              "Object.entries(porDefecto).forEach(([clave, valor]) => {",
              "  if (!pm.iterationData.has(clave)) pm.variables.set(clave, valor);",
              "});"
            ]
          }
        }
      ],
      "item": [
        {
          "name": "Consultar el catálogo completo",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// En el modo Performance de Postman no llegan los datos del archivo: se usa un nombre por defecto.",
                  "const caso = pm.iterationData.get('caso') ?? 'sin archivo de datos';",
                  "pm.test(`[${caso}] responde 200`, () => pm.response.to.have.status(200));",
                  "const libros = pm.response.json();",
                  "pm.test(`[${caso}] devuelve al menos 1 libro`, () => {",
                  "  pm.expect(libros).to.be.an('array');",
                  "  pm.expect(libros.length).to.be.at.least(1);",
                  "});",
                  "pm.test(`[${caso}] cada libro trae sus datos bibliográficos`, () => {",
                  "  libros.forEach((libro) => {",
                  "    pm.expect(libro.id).to.be.a('number');",
                  "    pm.expect(libro.titulo).to.be.a('string').and.not.empty;",
                  "    pm.expect(libro).to.include.keys('autores', 'editorial', 'materias', 'semestres');",
                  "  });",
                  "});",
                  "pm.test(`[${caso}] cada libro indica la disponibilidad de ejemplares físicos`, () => {",
                  "  libros.forEach((libro) => {",
                  "  pm.expect(libro.tiene_fisico, 'tiene_fisico').to.be.oneOf([0, 1]);",
                  "  if (libro.tiene_fisico === 1) {",
                  "    pm.expect(libro.total, 'total').to.be.a('number');",
                  "    pm.expect(libro.disponibles, 'disponibles').to.be.a('number');",
                  "    pm.expect(libro.disponibles).to.be.within(0, libro.total);",
                  "  }",
                  "  });",
                  "});",
                  "pm.test(`[${caso}] cada libro indica si tiene contenido digital`, () => {",
                  "  libros.forEach((libro) => {",
                  "    pm.expect(libro.tiene_digital).to.be.oneOf([0, 1]);",
                  "    pm.expect(libro).to.have.property('pdf_url');",
                  "  });",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/catalog",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "catalog"
              ]
            }
          }
        },
        {
          "name": "Buscar libros por título",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// En el modo Performance de Postman no llegan los datos del archivo: se usa un nombre por defecto.",
                  "const caso = pm.iterationData.get('caso') ?? 'sin archivo de datos';",
                  "pm.test(`[${caso}] responde 200`, () => pm.response.to.have.status(200));",
                  "const libros = pm.response.json();",
                  "pm.test(`[${caso}] devuelve al menos 1 libro`, () => {",
                  "  pm.expect(libros).to.be.an('array');",
                  "  pm.expect(libros.length).to.be.at.least(1);",
                  "});",
                  "const norm = (texto) => String(texto ?? '').normalize('NFD').replace(/[\\u0300-\\u036f]/g, '').toLowerCase();",
                  "const termino = norm(pm.variables.get('busquedaTitulo'));",
                  "pm.test(`[${caso}] cada resultado coincide por título o autor`, () => {",
                  "  libros.forEach((libro) => pm.expect(norm(libro.titulo).includes(termino) || norm(libro.autores).includes(termino), libro.titulo).to.be.true);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/catalog?search={{busquedaTitulo}}",
